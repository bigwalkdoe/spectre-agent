[Unit]
Description=Spectre System Maintenance Agent
After=network.target podman.socket docker.socket
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m apps.daemon.main
WorkingDirectory=%h/.config/spectre
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

# SPECTRE_API_KEY must be set here or the API refuses to start. Keep it 0600:
#   install -m 600 /dev/null %h/.config/spectre/spectre.env
#   echo 'SPECTRE_API_KEY=<key>' >> %h/.config/spectre/spectre.env
EnvironmentFile=-%h/.config/spectre/spectre.env

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/spectre
PrivateTmp=yes

[Install]
WantedBy=default.target
