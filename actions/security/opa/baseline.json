{
  "_comment": [
    "Declared control state for the Rego policies in ./policies.",
    "CI evaluates the policies against this file and fails on any denial, so a",
    "control cannot silently regress. Changing a value here is a deliberate,",
    "reviewable change: flipping one to false (or below a minimum) fails the job",
    "until the underlying configuration is fixed.",
    "These describe the configuration this repository ships, not the state of",
    "whatever machine runs CI -- a GitHub runner cannot observe a workstation."
  ],
  "audit_logging_enabled": true,
  "audit_retention_days": 90,
  "sudo_logging_enabled": true,
  "backup_encryption_enabled": true,
  "backup_retention_days": 7,
  "backup_offsite_enabled": true,
  "backup_verification_enabled": true,
  "database_backups_enabled": true,
  "docker_volume_backups_enabled": true,
  "security_baseline_compliant": true,
  "cis_benchmarks_followed": true,
  "pci_dss_compliant": true,
  "security_assessments_scheduled": true,
  "patch_management_active": true,
  "docker_not_root": true,
  "docker_no_new_privileges": true,
  "docker_userland_proxy_disabled": true,
  "docker_resource_limits": true,
  "docker_privileged_disabled": true,
  "encryption_at_rest_enabled": true,
  "encryption_in_transit_enabled": true,
  "tls_configured": true,
  "certificate_monitoring_enabled": true,
  "key_rotation_enabled": true,
  "firewall_enabled": true,
  "ssh_password_auth": false,
  "ssh_root_login": false,
  "fail2ban_active": true,
  "intrusion_detection_active": true,
  "file_integrity_monitoring": true,
  "fail2ban_configured": true,
  "log_monitoring_enabled": true,
  "alert_thresholds_configured": true,
  "network_segmentation_enabled": true,
  "dmz_isolated": true,
  "internal_no_internet": true,
  "vpn_enabled": true,
  "ddos_protection_enabled": true
}
